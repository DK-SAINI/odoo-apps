<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_automation_rule_tree" model="ir.ui.view">
        <field name="name">mail.automation.rule.list</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <list string="Dynamic Email Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_mail_automation_rule_form" model="ir.ui.view">
        <field name="name">mail.automation.rule.form</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <form string="Dynamic Email Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales Manager CC Rule"/>
                        </h1>
                    </div>
                    <group>
                        <group name="config" string="Basic Config">
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company" placeholder="Leave empty for Global"/>
                        </group>
                        <group name="description" string="Internal Note">
                            <field name="description" placeholder="Describe the purpose of this rule..."/>
                        </group>
                    </group>
                    <group string="Target Templates">
                        <field name="template_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Automation Settings" name="automation">
                            <group>
                                <field name="auto_to" placeholder="manager@example.com, assist@example.com"/>
                                <field name="auto_cc" placeholder="compliance@example.com, archive@example.com"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mail_automation_rule_search" model="ir.ui.view">
        <field name="name">mail.automation.rule.search</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <search string="Search Email Automation">
                <field name="name"/>
                <field name="template_ids"/>
                <filter string="Global Rules" name="global" domain="[('company_id', '=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mail_automation_rule" model="ir.actions.act_window">
        <field name="name">Email Automation Rules</field>
        <field name="res_model">mail.automation.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mail_automation_rule_search"/>
    </record>
</odoo>