<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_mail_automation_rule_tree" model="ir.ui.view">
        <field name="name">mail.automation.rule.tree</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <tree string="Dynamic Email Rules" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_mail_automation_rule_form" model="ir.ui.view">
        <field name="name">mail.automation.rule.form</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <form string="Dynamic Email Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Sales Manager CC Rule"/>
                        </h1>
                    </div>
                    <group>
                        <group name="config" string="Basic Config">
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company" placeholder="Leave empty for Global"/>
                        </group>
                        <group name="description" string="Internal Note">
                            <field name="description" placeholder="Describe the purpose of this rule..."/>
                        </group>
                    </group>
                    <group string="Target Templates">
                        <field name="template_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Automation Settings" name="automation">
                            <group>
                                <field name="auto_to" placeholder="manager@example.com, assist@example.com"/>
                                <field name="auto_cc" placeholder="compliance@example.com, archive@example.com"/>
                            </group>
                            <div class="alert alert-info" role="alert" style="margin-bottom:0px;">
                                💡 <b>How it works:</b>
                                <ul>
                                    <li>Recipients defined here will be <b>appended</b> to the standard template recipients.</li>
                                    <li>System will automatically <b>deduplicate</b> and <b>normalize</b> email addresses.</li>
                                    <li>Company-specific rules have <b>priority</b> over Global rules.</li>
                                </ul>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_mail_automation_rule_search" model="ir.ui.view">
        <field name="name">mail.automation.rule.search</field>
        <field name="model">mail.automation.rule</field>
        <field name="arch" type="xml">
            <search string="Search Email Automation">
                <field name="name"/>
                <field name="template_ids"/>
                <filter string="Global Rules" name="global" domain="[('company_id', '=', False)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mail_automation_rule" model="ir.actions.act_window">
        <field name="name">Email Automation Rules</field>
        <field name="res_model">mail.automation.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_mail_automation_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Automate your email recipients!
            </p>
            <p>
                Add dynamic TO/CC addresses to any email template. Support for Global and Company-specific overrides.
            </p>
        </field>
    </record>
</odoo>
